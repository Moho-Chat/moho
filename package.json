{
  "name": "moho",
  "version": "1.0.0-rc.1",
  "description": "Unified desktop chat client for IRC, Discord, Sneedchat and Matrix",
  "author": "Salastil",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Moho-Chat/moho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moho-Chat/moho.git"
  },
  "bugs": {
    "url": "https://github.com/Moho-Chat/moho/issues"
  },
  "main": "./out/main/index.js",
  "desktopName": "moho.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:ui": "electron-vite build && node scripts/ui-check.mjs",
    "pack": "npm run daemon && npm run build && MOHO_BUILD=$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty) electron-builder --linux AppImage",
    "pack:deb": "npm run daemon && npm run build && MOHO_BUILD=$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty) electron-builder --linux deb",
    "pack:linux": "npm run daemon && npm run build && MOHO_BUILD=$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty) electron-builder --linux AppImage deb",
    "pack:dir": "npm run daemon && npm run build && MOHO_BUILD=$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty) electron-builder --linux dir",
    "daemon": "./scripts/build-daemon.sh",
    "deploy": "npm run pack && ./scripts/install-desktop.sh",
    "daemon:win": "./scripts/build-daemon-win.sh",
    "pack:win": "npm run daemon:win && npm run build && MOHO_BUILD=$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty) electron-builder --win nsis"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "happy-dom": "^15.11.7",
    "hls.js": "^1.7.2",
    "livekit-client": "^2.22.2",
    "lottie-web": "^5.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.salastil.moho",
    "productName": "moho",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "nobilis/resources/sneedchat-smilies",
        "to": "sneedchat-smilies"
      },
      {
        "from": "resources/icons",
        "to": "icons"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Salastil <salastil@users.noreply.github.com>",
      "category": "Network",
      "synopsis": "Unified desktop chat client",
      "icon": "resources/icons/moho.png",
      "desktop": {
        "entry": {
          "Name": "moho",
          "Comment": "Unified chat client for IRC, Discord, Sneedchat and Matrix"
        }
      },
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "nobilis/target/release/nobilis",
          "to": "nobilis"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/moho.png",
      "extraResources": [
        {
          "from": "nobilis/target/release/nobilis.exe",
          "to": "nobilis.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "artifactName": "${productName}-${env.MOHO_BUILD}.${ext}",
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "allowScripts": {
    "electron@44.4.4": true,
    "esbuild@0.21.5": true
  }
}
