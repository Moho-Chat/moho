{
  "name": "moho",
  "version": "0.1.0",
  "description": "Unified desktop chat client for IRC, Discord, Sneedchat and Matrix",
  "author": "Salastil",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.salastil.moho",
    "productName": "moho",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/sockchat-smilies",
        "to": "sockchat-smilies"
      },
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "target/release/chatd",
        "to": "chatd"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
